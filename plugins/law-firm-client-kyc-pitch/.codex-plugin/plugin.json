  "interface": {
    "displayName": "\u5f8b\u6240 Client KYC Pitch",
    "shortDescription": "\u4e3b\u52a8\u6838\u9a8c\u6cd5\u89c4\u8d44\u8d28\u3001\u96c6\u56e2IP\u4e0e\u4e09\u5e02\u573a\u4e0a\u5e02\u53c2\u7167",
    "longDescription": "\u56fa\u5b9a\u4fdd\u7559\u516b\u7ae0\u76ee\u5f55\uff0c\u5148\u62c6\u89e3\u5b9e\u8d28\u4e1a\u52a1\u5e76\u4e3b\u52a8\u68c0\u7d22\u9002\u7528\u6cd5\u5f8b\u6cd5\u89c4\u3001\u4e3b\u7ba1\u673a\u5173\u3001\u5e94\u6709\u8d44\u8d28\u53ca\u516c\u53f8\u5b9e\u6709\u8bc1\u7167\uff0c\u6838\u9a8c\u6301\u8bc1\u4e3b\u4f53\u4e0e\u5b9e\u9645\u7ecf\u8425\u5339\u914d\uff1b\u5efa\u7acb\u62a5\u544a\u57fa\u51c6\u65e5\u5168\u90e8\u76f4\u63a5\u3001\u95f4\u63a5\u3001\u534f\u8bae\u63a7\u5236\u53ca\u5e76\u8868\u4e3b\u4f53\u6e05\u5355\uff0c\u5bf9\u5168\u96c6\u56e2\u5b8c\u6210\u77e5\u8bc6\u4ea7\u6743\u57fa\u7840\u626b\u63cf\u5e76\u6df1\u67e5\u6838\u5fc3IP\uff1b\u7b2c\u516d\u7ae0\u5bf9A\u80a1\u3001\u6e2f\u80a1\u3001\u7f8e\u80a1\u5404\u9009\u4e0d\u5c11\u4e8e3\u5bb6\u4e0a\u5e02\u53c2\u7167\uff0c\u6bcf\u4e2a\u5e02\u573a\u5305\u62ec1\u5bb6\u4e3bBenchmark\u548c\u81f3\u5c112\u5bb6\u76f8\u90bb\u53c2\u7167\uff0c\u9010\u5bb6\u8bf4\u660e\u53ef\u6bd4\u5c40\u9650\u5e76\u4fdd\u7559\u53ef\u70b9\u51fb\u6765\u6e90\u548c\u5b98\u65b9\u4ea7\u54c1\u56fe\uff1b\u518d\u7ed3\u5408\u5de5\u5546\u3001\u91d1\u878d\u3001\u65b0\u95fb\u53ca\u8d44\u672c\u5e02\u573a\u4fe1\u606f\u5f62\u6210\u6cd5\u5f8b\u5206\u6790\u3001\u5546\u4e1a\u6d1e\u5bdf\u3001Pitch\u542f\u793a\u548c\u9ad8\u4ef7\u503c\u4f1a\u9762\u95ee\u9898\u3002",
    "developerName": "zoe",
    "category": "Productivity",
    "capabilities": [
      "Research",
      "Write"
    ],
    "brandColor": "#FFA43D",
    "composerIcon": "./skills/law-firm-client-kyc-pitch/assets/icon.svg",
    "defaultPrompt": [
      "\u5b8c\u5584\u9644\u4ef6\u4f01\u4e1a\u80cc\u666f\u62a5\u544a\uff0c\u4e3b\u52a8\u8865\u67e5\u9002\u7528\u6cd5\u89c4\u3001\u5e94\u6709\u8d44\u8d28\u4e0e\u5b9e\u6709\u8bc1\u7167\uff0c\u5efa\u7acb\u63a7\u80a1\u53ca\u5e76\u8868\u4e3b\u4f53\u5168\u96c6\u5b8c\u6210\u96c6\u56e2IP\u626b\u63cf\uff0c\u5e76\u4fdd\u7559\u539f\u6709\u6709\u6548\u6765\u6e90\u548c\u5b98\u65b9\u4ea7\u54c1\u56fe\u3002",
      "\u7814\u7a76\u76ee\u6807\u516c\u53f8\uff0c\u5148\u5b8c\u6210\u6cd5\u89c4\u4e0e\u8d44\u8d28\u4e3b\u52a8\u8c03\u67e5\u3001\u5168\u96c6\u56e2IP\u57fa\u7840\u626b\u63cf\u53ca\u6838\u5fc3\u6743\u5c5e\u6df1\u67e5\uff0c\u518d\u751f\u6210\u5f8b\u5e08Pitch\u524dClient KYC\u516b\u7ae0\u62a5\u544a\u3002",
      "\u4ec5\u66f4\u65b0\u7b2c\u516d\u7ae0\u540c\u884c\u4e1a\u5bf9\u6bd4\uff1aA\u80a1\u3001\u6e2f\u80a1\u3001\u7f8e\u80a1\u5404\u4e0d\u5c11\u4e8e3\u5bb6\uff0c\u6bcf\u4e2a\u5e02\u573a1\u5bb6\u4e3bBenchmark\u548c\u81f3\u5c112\u5bb6\u76f8\u90bb\u53c2\u7167\uff0c\u9010\u5bb6\u5199\u660e\u53ef\u6bd4\u5c40\u9650\u5e76\u4fdd\u7559\u53ef\u70b9\u51fb\u6765\u6e90\u3002"
    ]
  }
